// Function to display the hash table
void displayHash(struct Hashing* hashTable) {
    for (int i = 0; i < hashTable->hash_bucket; i++) {
        printf("%d", i);
        struct Node* temp = hashTable->hashtable[i];
        
        // Print the linked list at this index
        dis(temp);
        printf("\n");
    }
}
int main() {
    int hash_array[7];
    // printf("Enter 7 integers for the hash table:\n");
    for (int i = 0; i < 7; i++) {
        scanf("%d", &hash_array[i]);
    }
    int n = sizeof(hash_array) / sizeof(hash_array[0]);

    struct Hashing* hashTable = createHashing(7); // Number of buckets = 7

    // insert the keys into the hash table
    for (int i = 0; i < n; i++) {
        insertKey(hashTable, hash_array[i]);
    }
    // display the Hash table
    printf("Hash table created:\n");
    displayHash(hashTable);

    return 0;
}

