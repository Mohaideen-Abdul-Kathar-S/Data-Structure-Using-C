


#include<stdio.h>
#include<stdlib.h>

struct node {
	int data;
	struct node *next;
};
typedef struct node *NODE;

NODE createNodeInCLL(int x) {
	NODE mnode =(NODE)malloc(sizeof(struct node));
mnode->data=x;
mnode->next=NULL;
return mnode;
}

NODE insertAtPositionInCLL(NODE head,int pos,int x) {
NODE mnode=createNodeInCLL(x);
if(head==NULL && pos!=1){
printf("Position not found\n");
}else if(pos==1){
mnode->next=head;
head=mnode;
}else{
NODE temp=head;
for(int i=1;i<pos-1 && temp!=NULL;i++){
temp=temp->next;
}
	if(temp==NULL){
		printf("Position not found\n");
		return head;
	}
mnode->next=temp->next;
temp->next=mnode;
}
return head;
}

NODE deleteAtPositionInCLL(NODE head,int pos) {
if(pos<1){
printf("Position not found\n");
return head;
}
if(pos==1){
NODE temp=head;
head=head->next;
printf("Deleted element: %d\n",temp->data);

free(temp);
return head;
}

NODE temp=head;
for(int i=1;i<pos-1 && temp!=NULL;i++){
temp=temp->next;
}


if(temp->next==NULL){
printf("Position not found\n");
return head;
}
NODE add=temp->next;
printf("Deleted element: %d\n",add->data);
temp->next=add->next;
free(add);
return head;
}

void traverseListInCLL(NODE head) {
NODE temp=head;
while(temp!=NULL){
printf("%d --> ",temp->data);
temp=temp->next;
}
printf("\n");
}

void main() {
	NODE first = NULL;
	int x, pos, op;
	while(1) {
		printf("1.Insert 2.Delete 3.Display 4.Exit\n");
		printf("choice: ");
		scanf("%d", &op);
		switch(op) {
			case 1:	printf("Position: ");
					scanf("%d", &pos);
					if (pos <= 0) {
						printf("Position not found\n");
					} else {
						printf("Element: ");
						scanf("%d", &x);
						first = insertAtPositionInCLL(first, pos, x);
					}
					break;
	        case 2:	if (first == NULL) {
						printf("CLL is empty\n");
					} else {
						printf("Position: ");
						scanf("%d", &pos);
						first = deleteAtPositionInCLL(first, pos);
					}
					break;
			case 3:	if (first == NULL) {
						printf("CLL is empty\n");
					} else {
						printf("Elements in CLL are: ");
						traverseListInCLL(first);
					}
					break;
			case 4:	exit(0);
		}
	}
}

