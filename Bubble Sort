

#include<stdio.h>

void main(){
int n;
printf("n: ");
scanf("%d",&n);
printf("Elements: ");
int arr[n];
for(int i=0;i<n;i++){
scanf("%d",&arr[i]);
}
printf("Before sorting: ");
for(int i=0;i<n;i++){
printf("%d ",arr[i]);
}
printf("\n");
for(int j=1;j<n;j++){
for(int i=0;i<n-1;i++){
if(arr[i]>arr[i+1]){
int temp = arr[i];
arr[i]=arr[i+1];
arr[i+1]=temp;
}
}

}
printf("After sorting: ");
for(int i=0;i<n;i++){
printf("%d ",arr[i]);
}
printf("\n");

}

