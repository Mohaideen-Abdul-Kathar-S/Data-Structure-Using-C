


#include <stdio.h>
#include <stdlib.h>
#include<string.h>
struct Movie {
    char title[100];
    int releaseYear;
    struct Movie* next;
    struct Movie* prev;
};

// Function to create a new movie node
struct Movie* createMovieNode(char title[], int releaseYear) {
    struct Movie* node = (struct Movie*)malloc(sizeof(struct Movie));
    strcpy(node->title,title);
	node->releaseYear=releaseYear;
	return node;
}

// Function to insert a new movie at the end of the double-linked list
struct Movie* insertMovieEnd(struct Movie* head, char title[], int releaseYear) {
    struct Movie* node=createMovieNode(title,releaseYear);
    if(head==NULL){
		head=node;
	}else{
		struct Movie* temp=head;
		while(temp->next!=NULL){
			temp=temp->next;
		}
		temp->next=node;
	}
	return head;
}

// Function to print details of all movies in the catalog
void printMovieCatalog(struct Movie* head) {
    struct Movie *temp=head;
    while(temp!=NULL){
		printf("Title: %s\nRelease Year: %d\n",temp->title,temp->releaseYear);
		temp=temp->next;
	}
}

int main() {
    int numMovies;
    scanf("%d", &numMovies);

    struct Movie* catalog = NULL;

    for (int i = 0; i < numMovies; ++i) {
        char title[100];
        int releaseYear;
        scanf("%s %d", title, &releaseYear);
        catalog = insertMovieEnd(catalog, title, releaseYear);
    }

    printMovieCatalog(catalog);

    return 0;
}

