
#include<stdio.h>
#include<stdlib.h>

typedef struct Node{
int data;
struct Node* next;
}*Node;
Node head=NULL;
Node create(int data){
Node node=(Node)malloc(sizeof(struct Node));
node->data=data;
node->next=NULL;
return node;
} 

void insert(int data){
Node node = create(data);
if(head==NULL){
head=node;
}else{
node->next=head;
head=node;
}
}

void print(void){
if(head!=NULL){
Node temp=head;
printf("Given linked list: ");
while(temp!=NULL){
printf("%d-->",temp->data);
temp=temp->next;
}
}
printf("Null\n");
}

int search(int n){

int c=0;
Node temp=head;
while(temp!=NULL){
if(temp->data==n){
c++;}
temp=temp->next;


}
return c;

}

void main(){
int n,m;
scanf("%d",&n);
for(int i=0;i<n;i++){
scanf("%d",&m);
insert(m);
}
print();
scanf("%d",&m);
m=search(m);
printf("%d\n",m);
}


