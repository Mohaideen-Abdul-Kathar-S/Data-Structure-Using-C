

#include <stdio.h>
int insert(int hashTable[], int m, int key) {
    int index = key%m;
    int i = 1;
    
    while (hashTable[index]!=-1) {
        index = (index + i * i) % m;
        i++;
    }
	hashTable[index]=key;
    return 0;  // Hash table is full, insertion failed
}

