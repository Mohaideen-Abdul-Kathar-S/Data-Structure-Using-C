


#include <stdio.h>
#include <stdlib.h>

// Node structure
struct Node {
    int rollNumber;
    struct Node* next;
};
struct Node* head;
// Function to create a circular linked list
struct Node* createCircularList(int studentIDs[], int N) {

	for(int i=0;i<N;i++){
		
		struct Node* node = (struct Node*)malloc(sizeof(struct Node));
		
			node->rollNumber=studentIDs[i];
		if(head==NULL){
			head=node;
		}else{
			struct Node* temp=head;
			while(temp->next!=NULL){
				temp=temp->next;
			}
			temp->next=node;
		}
	}
	return head;
	
}

// Function to print the circular linked list
void printCircularList(struct Node* head) {
	
	struct Node* temp=head;
	while(temp!=NULL){
		printf("%d -> ",temp->rollNumber);
		temp=temp->next;
	}
}

int main() {
    int N;
    scanf("%d", &N);
    int studentIDs[N];
    for (int i = 0; i < N; i++) {
        scanf("%d", &studentIDs[i]);
    }

    // Create circular linked list
    struct Node* circularList = createCircularList(studentIDs, N);

    // Print circular linked list
    printCircularList(circularList);

    return 0;
}

