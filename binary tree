void store(Node *root,Node *New){
	if(root->data>New->data){
		if(root->left==NULL){
			root->left=New;
			return;
		}
		store((root->left),New);
	}else{
		if(root->rigth==NULL){
			root->rigth=New;
			return;
		}
		store((root->rigth),New);
	}
}
void insert(Node **root,int data){
	Node *New = create(data);
	if(*root==NULL){
		*root=New;
		return;
	}
	store(*root,New);
}


Node *search(Node *root, int d) {
    if (root == NULL || root->data == d) {
        return root;  // Return the found node or NULL if not found
    } 
    if (root->data > d) {
        return search(root->left, d);
    } 
    return search(root->rigth, d);
}

void display(Node *root){
	if(root!=NULL){
		display((root->left));
		printf("%d ",root->data);
		display((root->rigth));
	}
}

Node *most(Node *root) {
    while (root->left != NULL) {
        root = root->left;
    }
    return root;
}

void delete_node(Node **root, int data) {
 if (*root == NULL) {
        printf("Node not found\n");
        return;
 }

    if (*root == NULL) return;

    if (data < (*root)->data) {
        delete_node(&(*root)->left, data);
    } else if (data > (*root)->data) {
        delete_node(&(*root)->rigth, data);
    } else {
        
        if ((*root)->left == NULL) {
            Node *temp = *root;
            *root = (*root)->rigth;
            free(temp);
return ;

        } else if ((*root)->rigth == NULL) {
            Node *temp = *root;
            *root = (*root)->left;
            free(temp);
return;

        } else {
            
            Node *temp = most((*root)->rigth);
            
            (*root)->data = temp->data;
            
            delete_node(&(*root)->rigth, temp->data);
        }
    }



