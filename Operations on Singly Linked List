

#include <stdio.h>
#include <stdlib.h>

struct node {
    int value;
    struct node *next;
};
struct node *head=NULL;
void insert(){
int n;

struct node* Node = (struct node*)malloc(sizeof(struct node)); 
printf("Element: ") && scanf("%d",&n);
Node->value=n;

Node->next=NULL;
if(head==NULL){
head=Node;
}else{
struct node *temp = head;
while(temp->next!=NULL){
temp=temp->next;
}
temp->next=Node;
}
}

void delete_node(){
int n;
printf("Position: ") && scanf("%d",&n);
struct node *temp=head;
if(n==1){
head=head->next;
free(temp);
printf("Deleted succssfully\n");
return;
}

for(int i=1;i<n-1 && temp!=NULL;i++){
temp=temp->next;
}
if(temp==NULL||temp->next==NULL){
printf("Invalid position\n");
}else{
struct node *prev=temp->next->next;
free(temp->next);
temp->next=prev;
free(prev);

printf("Deleted successfully\n");
}
}

void display(){
struct node *temp = head;
printf("Elements of linked list: ");
while(temp!=NULL){
printf("%d ",temp->value);
temp=temp->next;
}
printf("\n");

}

void count(){
struct node *temp = head;
int n=0;
while(temp!=NULL){
n++;
temp=temp->next;
}
printf("No of elements: %d\n",n);

}

int main() {
    int option = 0;
    while (option != 5) {
        printf("1.Insert 2.Delete 3.Display 4.Count 5.Exit\n");
        printf("choice: ");
        scanf("%d", &option);
        switch (option) {
            case 1:
                insert();
                break;
            case 2:
                delete_node();
                break;
            case 3:
                display();
                break;
            case 4:
                count(); 
                break;
            case 5:
                exit(0);
                break;
            default:
                printf("Enter options from 1 to 5\n");
                break;
        }
    }
    return 0;
}
