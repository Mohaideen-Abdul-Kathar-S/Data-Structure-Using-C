void push(char x) {
ex[++top]=x;

}


char pop() {
return ex[top--];

}

int priority(char x) {

	if(x=='^'){
		if(ex[top]==x){
			push(x);
			return 0;
		}
		return 1;
	}
	else if(x=='/' || x=='*'){
		while(1){
		if(ex[top]=='^' || ex[top]=='/' || ex[top]=='*'){
			arr[i++]=pop();
		}else return 1;
	}
	}
	else if(x=='+' || x=='-'){
		while(1){
			if(ex[top]=='^' || ex[top]=='/' || ex[top]=='*' || ex[top]=='+' || ex[top]=='-'){
				arr[i++]=pop();
			}else return 1;
		}
	}
	else if(x=='('){
		par++;
		return 1;
	}else if(x==')'){
		par--;
		while(1){
			if(ex[top]!='(') arr[i++]=pop();
			else return 0; 
		}
	}
	else{printf("Invalid symbols in infix expression\n");
		pp=1;}
	return 0;

}

